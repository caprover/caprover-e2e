# Existing-server E2E configuration
CAPROVER_URL=https://captain.example.com
CAPROVER_PASSWORD=your-password
SSH_USER=root
SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"

# Optional. Defaults to the hostname from CAPROVER_URL.
# SSH_HOST=192.0.2.10

# Optional. Defaults to 22.
# SSH_PORT=22

# Ephemeral provisioning configuration. Required only for `npm run provision`
# and `npm run test:ephemeral`.
# DIGITALOCEAN_TOKEN=...
# DIGITALOCEAN_SSH_KEY_ID=...
# CLOUDFLARE_API_TOKEN=...
# CLOUDFLARE_ZONE_ID=...
# E2E_BASE_DOMAIN=example.com
# CAPROVER_E2E_SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"

# Optional ephemeral provisioning overrides.
# DIGITALOCEAN_REGION=nyc3
# DIGITALOCEAN_SIZE=s-1vcpu-2gb
# DIGITALOCEAN_IMAGE=docker-20-04
# CAPROVER_IMAGE=caprover/caprover-edge

# Specialized opt-in Git webhook workflow only. Point both URLs at the same
# dedicated private GitHub repository containing tests/fixtures/git-webhook-repo/captain-definition.
# E2E_GIT_HTTPS_REPO=https://github.com/owner/private-fixture.git
# E2E_GIT_SSH_REPO=git@github.com:owner/private-fixture.git
# E2E_GIT_BRANCH=main
# E2E_GIT_HTTP_USER=x-access-token
# E2E_GIT_HTTP_PASSWORD=read-only-fine-grained-token
# E2E_GIT_SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"
# E2E_GIT_EXPECTED_COMMIT=40-character-commit-sha
