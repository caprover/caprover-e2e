{
    "name": "caprover-e2e",
    "version": "0.1.0",
    "private": true,
    "description": "External end-to-end tests for a provisioned CapRover server",
    "license": "MIT",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "test": "npm run typecheck && vitest run",
        "test:unit": "vitest run tests/unit",
        "test:ephemeral": "npm run build:provisioning && node .provisioning-dist/provisioning/commands/test-ephemeral.js",
        "provision": "npm run build:provisioning && node .provisioning-dist/provisioning/commands/provision.js",
        "destroy": "npm run build:provisioning && node .provisioning-dist/provisioning/commands/destroy.js",
        "build:provisioning": "tsc -p tsconfig.provisioning.json",
        "typecheck": "tsc --noEmit",
        "format": "prettier --check .",
        "format:write": "prettier --write .",
        "diagnose": "npm run build:provisioning && node .provisioning-dist/provisioning/commands/diagnose.js"
    },
    "dependencies": {
        "caprover-api": "0.0.20",
        "ssh2": "1.17.0"
    },
    "devDependencies": {
        "@types/node": "22.20.3",
        "@types/ssh2": "1.15.6",
        "prettier": "3.9.6",
        "typescript": "5.9.3",
        "vitest": "5.0.1"
    }
}
